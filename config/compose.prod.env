COMPOSE_PROJECT_NAME=cogniz
DATA_DIR=./data/prod

# Public endpoints. The API is served by Next.js at WEB_ORIGIN + API_PUBLIC_PATH.
WEB_BIND_ADDRESS=0.0.0.0
WEB_DOMAIN=cogniz.example.com
WEB_PORT=80
WEB_ORIGIN=https://cogniz.example.com

API_DOMAIN=cogniz.example.com
API_PORT=443
API_PUBLIC_PATH=/api
API_INTERNAL_HOST=cogniz-api
API_INTERNAL_PORT=8000
API_WORKERS=2

# Agent execution hard limits. Admin policies can only choose lower values.
AGENT_HARD_MAX_OUTPUT_TOKENS=262144
AGENT_HARD_TOTAL_TOKENS_LIMIT=524288
AGENT_HARD_REQUEST_LIMIT=20
AGENT_HARD_TOOL_CALLS_LIMIT=20
AGENT_HARD_TIMEOUT_SECONDS=3600

# Application and database settings
COOKIE_SECURE=true
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT=30
POSTGRES_USER=postgres
POSTGRES_DB=cogniz
