COMPOSE_PROJECT_NAME=cogniz
DATA_DIR=./data/dev

# Public development endpoints
WEB_BIND_ADDRESS=0.0.0.0
WEB_DOMAIN=localhost
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

API_BIND_ADDRESS=0.0.0.0
API_DOMAIN=localhost
API_PORT=8000
API_PUBLIC_PATH=/api
API_INTERNAL_HOST=cogniz-api
API_INTERNAL_PORT=8000

# Infrastructure exposed for local development
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cogniz

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Encrypts AI provider API keys stored in PostgreSQL. Keep this value stable.
AI_PROVIDER_ENCRYPTION_KEY=cogniz-local-development-key
